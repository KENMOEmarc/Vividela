# =============================================================================
# .env.example — Variables d'environnement frontend
#
# UTILISATION :
#   Copier ce fichier en .env et ajuster les valeurs :
#   cp .env.example .env
#
# IMPORTANT :
#   - Le fichier .env est ignoré par git (.gitignore)
#   - Toutes les variables VITE_ sont injectées dans le bundle au BUILD
#     (pas au runtime) → ne pas y mettre de secrets critiques
#   - En production, configurer les variables sur le serveur/CI/CD
# =============================================================================

# URL de base de l'API backend
# Développement : /api → proxy Vite vers localhost:8080
# Production    : URL complète du backend
VITE_API_URL=/api

# Nom de l'application (affiché dans la navbar, onglet...)
VITE_APP_NAME=AuthApp

# Durée d'expiration du token affichée à l'utilisateur (indicatif)
VITE_TOKEN_EXPIRY_HOURS=24

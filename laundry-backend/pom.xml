<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
    ============================================================
    PARENT SPRING BOOT
    Fournit la gestion des versions pour toutes les dépendances
    Spring Boot (auto-configuration, starters, plugins Maven).
    ============================================================
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.10</version>
        <relativePath/>
    </parent>

    <!-- Identité du projet -->
    <groupId>com.template</groupId>
    <artifactId>vividela-backend</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>vividela-backend</name>
    <description>
        Architecture MVC | JWT | MySQL
    </description>

    <!-- Version Java cible -->
    <properties>
        <java.version>21</java.version>
        <!-- Version de la librairie JWT -->
        <jjwt.version>0.12.6</jjwt.version>
        <!-- Forcer connector-j 9.x pour MySQL 8.4 (suppression de mysql_native_password) -->
        <mysql-connector-j.version>9.1.0</mysql-connector-j.version>
        <lombok.version>1.18.38</lombok.version>
        <!-- Spring AI — utilisé pour l'analyse IA (Gemini) des avis clients,
             voir GeminiReviewAnalysisService. -->
        <spring-ai.version>1.1.6</spring-ai.version>
    </properties>

    <!-- =====================================================
         SPRING AI BOM — aligne automatiquement les versions de tous les
         starters Spring AI (ne jamais fixer de <version> individuelle sur
         un artefact org.springframework.ai : ça casse l'alignement du BOM).
         ===================================================== -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- =====================================================
         Dépôt de secours pour les artefacts Spring AI si une version
         milestone/RC venait à être utilisée (les versions GA sont sur
         Maven Central). Sans impact si tout se résout déjà via Central.
         ===================================================== -->
    <repositories>
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>

        <!-- =====================================================
             WEB — Fournit Spring MVC, le serveur Tomcat embarqué,
             Jackson (JSON), et tout le nécessaire REST.
             ===================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- =====================================================
             SECURITY — Filtre d'authentification, gestion des
             permissions, encodage des mots de passe (BCrypt).
             ===================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- =====================================================
             JPA / HIBERNATE — ORM pour mapper les entités Java
             vers les tables PostgreSQL, gestion des transactions.
             ===================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- =====================================================
             VALIDATION — Annotations @NotBlank, @Email, @Size…
             pour valider les DTOs en entrée des contrôleurs.
             ===================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- =====================================================
             MYSQL — Driver JDBC pour la connexion à la base
             de données MySQL 8.x.
             ===================================================== -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- =====================================================
             LOMBOK — Génération automatique de getters, setters,
             constructeurs, builders via annotations (@Data, @Builder…).
             Évite le code boilerplate.
             ===================================================== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- =====================================================
             JWT (JSON Web Token) — Librairie JJWT pour générer,
             signer et valider les tokens JWT (HS256).
             ===================================================== -->
        <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-api</artifactId>
        <version>${jjwt.version}</version>
    </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- =====================================================
             OPENPDF — Génération de documents PDF (tickets de commande).
             Librairie 100% Java, pas de dépendance native.
             ===================================================== -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>1.3.39</version>
        </dependency>

        <!-- =====================================================
             MAIL — Spring Boot starter fournissant JavaMailSender
             pour l'envoi d'emails via SMTP (Gmail, SendGrid, etc.).
             ===================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- =====================================================
             TWILIO — Envoi de SMS. Compte d'essai (trial) gratuit
             disponible sur https://www.twilio.com/try-twilio
             ===================================================== -->
        <dependency>
            <groupId>com.twilio.sdk</groupId>
            <artifactId>twilio</artifactId>
            <version>10.6.3</version>
        </dependency>

        <!-- =====================================================
             DOTENV — Charge automatiquement le fichier .env à la racine
             du projet dans l'Environment Spring au démarrage. Sans cette
             dépendance, les ${VARS} de application.yml ne sont jamais
             résolues à partir de .env (il faudrait les exporter à la main
             dans le shell, ou compter sur docker-compose uniquement).
             ===================================================== -->
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>spring-dotenv</artifactId>
            <version>4.0.0</version>
        </dependency>

        <!-- =====================================================
             SPRING AI — GOOGLE GENAI (GEMINI) — utilisé pour analyser (via
             l'API Gemini 2.5) le sentiment des avis clients avant de
             notifier le manager du pressing. Voir GeminiReviewAnalysisService
             et les propriétés spring.ai.google.genai.* (application.yml).
             ===================================================== -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-google-genai</artifactId>
        </dependency>

        <!-- =====================================================
             TESTS — Spring Test + JUnit 5 + Mockito.
             ===================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- =====================================================
             H2 — Base de données en mémoire pour les tests.
             Remplace PostgreSQL sans nécessiter de serveur externe.
             PostgreSQL-compatible mode (MODE=PostgreSQL dans l'URL JDBC).
             ===================================================== -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

        <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <!-- Use release to ensure correct cross-compilation and avoid internal TypeTag issues -->
                    <release>21</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <!-- Fork the compiler to isolate from Maven's embedded javac implementations when necessary -->
                    <fork>true</fork>
                </configuration>
            </plugin>
            <!-- Plugin Maven pour compiler et packager l'application -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Exclure Lombok du JAR final (annotations compilées) -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>

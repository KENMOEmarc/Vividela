config.stopBubbling = true

# CORRECTION : @RequiredArgsConstructor (Lombok) ne copie par défaut AUCUNE
# annotation placée sur un champ vers le paramètre correspondant du
# constructeur qu'il génère. @Lazy posé sur le champ
# OrderServiceImpl.articleService (utilisé pour casser le cycle de
# dépendances ArticleServiceImpl → OrderServiceImpl → ArticleService) était
# donc invisible pour Spring au moment de l'injection, et le cycle
# persistait malgré l'annotation — provoquant l'échec de démarrage
# "The dependencies of some of the beans ... form a cycle".
#
# Cette ligne indique explicitement à Lombok de recopier @Lazy sur le
# paramètre généré, ce qui est la façon documentée de combiner
# @RequiredArgsConstructor avec @Lazy pour résoudre un cycle Spring.
lombok.copyableAnnotations += org.springframework.context.annotation.Lazy

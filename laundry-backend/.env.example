# .env.example — template (NE PAS COMMITTER de secrets réels)

# --- Email (JavaMailSender / SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-app-password
MAIL_FROM=no-reply@laundrycare.local

# --- Twilio (SMS) ---
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Spring / App ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Datasource (MySQL) ---
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/auth_db
SPRING_DATASOURCE_USERNAME=auth_user
SPRING_DATASOURCE_PASSWORD=auth_password

# --- Docker / MySQL (docker-compose) ---
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=auth_db
MYSQL_USER=auth_user
MYSQL_PASSWORD=auth_password

# --- JWT ---
# Remplacez par une clé aléatoire d'au moins 32 caractères ASCII
JWT_SECRET=replace_with_random_at_least_32_chars
JWT_EXPIRATION=86400000

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=


# --- Identité boutique (tickets/reçus PDF) ---
SHOP_NAME=LaundryCare
SHOP_PHONE=+237 000 000 000
SHOP_EMAIL=contact@laundrycare.com

# --- Spring AI / Gemini (analyse des avis clients) ---
# Clé API gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
